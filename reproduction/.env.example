# Copy this file to .env (same directory) and fill in your credentials.
# .env is gitignored and must NEVER be committed.
#
# MQSS / IQM Euro-Q-Exa (EQE1) — required for hardware/horoscope_qexa.py
# Obtain a token from the LRZ MQSS portal.
MQSS_TOKEN=your_mqss_token_here

# IBM Quantum — optional, only for `horoscope_mechanism.py --backend ibm`.
# Obtain a token at https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=your_token_here
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_URL=
